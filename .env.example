# Copy to .env and fill in only what you need. Nothing here is required to run tests or sample mode.

# Where data lives (default: ./data)
MOBILITYOPS_DATA_DIR=./data

# "sample" uses deterministic synthetic data; "real" uses downloaded NYC TLC + NOAA data.
MOBILITYOPS_MODE=sample

# Logging: DEBUG, INFO, WARNING, ERROR
MOBILITYOPS_LOG_LEVEL=INFO

# Optional: enables the LLM-backed AI analyst. Without a key the analyst still works in
# deterministic mode and the app reports LLM mode as unavailable. NEVER commit a real key.
ANTHROPIC_API_KEY=
MOBILITYOPS_LLM_MODEL=

# API: if set, every /api/v1 request must send this value in the X-API-Key header.
# Leave empty for local use only; the server binds to 127.0.0.1 by default.
MOBILITYOPS_API_KEY=

# Comma-separated browser origins allowed to call the API (no wildcard). Default: Vite dev server.
MOBILITYOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cap LightGBM's threads (default 0 = all cores). Set this when several jobs share a machine:
# oversubscribed OpenMP threads spin and can slow everything down by orders of magnitude.
MOBILITYOPS_THREADS=0

# Public deployments: per-client requests per minute on /api/v1 (0 = off), a tighter budget for the
# analyst and scenario endpoints, and whether the client IP may be read from X-Forwarded-For (set
# this only when the app sits behind your own reverse proxy).
MOBILITYOPS_RATE_LIMIT=0
MOBILITYOPS_RATE_LIMIT_HEAVY=0
MOBILITYOPS_TRUST_PROXY=
