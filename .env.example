# Copy to .env and fill in only what you need. Nothing here is required to run tests or sample mode.

# Where data lives (default: ./data)
MOBILITYOPS_DATA_DIR=./data

# "sample" uses deterministic synthetic data; "real" uses downloaded NYC TLC + NOAA data.
MOBILITYOPS_MODE=sample

# Logging: DEBUG, INFO, WARNING, ERROR
MOBILITYOPS_LOG_LEVEL=INFO

# Optional: enables the LLM-backed AI analyst. Without a key the analyst still works in
# deterministic mode and the app reports LLM mode as unavailable. NEVER commit a real key.
ANTHROPIC_API_KEY=
MOBILITYOPS_LLM_MODEL=
