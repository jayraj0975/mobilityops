# Copy to .env (Docker Compose) or /etc/mobilityops/mobilityops.env (systemd) and edit.

# REQUIRED. A long random value; generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The web dashboard asks for it once per browser; the Android app has a field for it in Settings.
MOBILITYOPS_API_KEY=

# real = the downloaded NYC data; sample = synthetic test data
MOBILITYOPS_MODE=real

# Docker Compose only: 127.0.0.1 serves this machine, 0.0.0.0 serves your whole network.
MOBILITYOPS_BIND=127.0.0.1
MOBILITYOPS_PORT=8000

# Requests per minute per client (0 turns the limit off); heavy = analyst and scenario endpoints.
MOBILITYOPS_RATE_LIMIT=240
MOBILITYOPS_RATE_LIMIT_HEAVY=20

# Number of reverse proxies in front (0 when clients connect directly; 1 behind the Caddy profile).
MOBILITYOPS_TRUST_PROXY=0

# Live tab: poll Citi Bike / weather while someone is watching, and the replay speed
# (seconds of wall clock per hour of replayed data).
MOBILITYOPS_LIVE_FEEDS=true
MOBILITYOPS_LIVE_SECONDS_PER_HOUR=2

# HTTPS profile only: the name clients use. "localhost" gives a locally trusted certificate.
MOBILITYOPS_DOMAIN=localhost
# A production domain instead (both set; DNS must point at this machine first; docs/PRODUCTION.md):
# MOBILITYOPS_WWW_HOST=www.example.org
# MOBILITYOPS_API_HOST=api.example.org
# Only if the console is served from a different origin than the API (never "*"):
# MOBILITYOPS_CORS_ORIGINS=https://www.example.org

# Pune (MOBILITYOPS_MODE=pune): traffic (TomTom) and station air quality (OpenAQ) are listed but have
# no adapter yet, so no key enables them (docs/PUNE_DATA_SOURCES.md). Nothing to set here.

# Docker Compose: the user the containers run as. It must own ./data/live (Pune live state) on the
# host. Use your own ids: `id -u` and `id -g`. (The image's own user is 10001.)
MOBILITYOPS_UID=10001
MOBILITYOPS_GID=10001

# Model threads (0 = every core).
MOBILITYOPS_THREADS=2
