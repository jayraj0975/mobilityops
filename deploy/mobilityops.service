# systemd unit for running MobilityOps without Docker. Install steps: docs/SELF_HOSTING.md.
[Unit]
Description=MobilityOps API and dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=mobilityops
Group=mobilityops
WorkingDirectory=/opt/mobilityops
EnvironmentFile=/etc/mobilityops/mobilityops.env
Environment=MOBILITYOPS_DATA_DIR=/opt/mobilityops/data
Environment=MOBILITYOPS_WEB_DIST=/opt/mobilityops/apps/web/dist
ExecStart=/opt/mobilityops/.venv/bin/python -m mobilityops.cli serve --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

# The service only reads its data and writes nothing.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
ReadOnlyPaths=/opt/mobilityops

[Install]
WantedBy=multi-user.target
